# ============================================================
# Regina Nostra Schools: server settings
# Local development: copy this file to backend/.env
# Dokploy: paste these lines (with real values) into the app's Environment tab
# ============================================================

# ---- Server ----
NODE_ENV=production
PORT=5000

# Website address(es), comma-separated. The first one is used for links in emails.
FRONTEND_URL=https://reginanostraschools.com,https://www.reginanostraschools.com

# ---- Database (MongoDB) ----
# Atlas:   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/regina-nostra
# Dokploy: use the database's "Internal connection URL"
MONGODB_URI=

# ---- Login security ----
# Long random secret for login tokens. Generate one with:  openssl rand -hex 32
# Changing it later signs everyone out.
JWT_SECRET=

# ---- Email (SMTP, secure connection on port 465) ----
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_USER=your Gmail address,
#        EMAIL_PASS=an App Password (Google Account > Security > App passwords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
# Sender shown to recipients; contact-form messages are also delivered here.
# Use the same address as EMAIL_USER (with Gmail) so emails don't land in spam.
EMAIL_FROM=Regina Nostra Schools <reginanostraschools@gmail.com>

# ---- File uploads: Cloudflare R2 ----
# Cloudflare dashboard > R2 > your bucket and Manage API tokens (Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=regina-nostra-files
# Public address of the bucket (custom domain or r2.dev URL), no trailing slash
R2_PUBLIC_URL=https://files.reginanostraschools.com

# ---- First admin account ----
# Only used when you run the seed command once on a new database:
#   node dist/utils/seedAdmin.js
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Optional ----
# Requests allowed per network every 15 minutes (whole school often shares one IP)
# RATE_LIMIT_MAX=2000
# Sign-in / password-reset attempts allowed per network every 15 minutes
# AUTH_RATE_LIMIT_MAX=50
