# Copy to backend/.env for local development.
# In Dokploy, paste these (with real values) into the app's Environment tab.

NODE_ENV=production
PORT=5000

# Website address(es). The first one is used in email links.
FRONTEND_URL=https://reginanostraschools.com,https://www.reginanostraschools.com

# Database
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DBNAME

# Login tokens: use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Email (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# File uploads: Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://files.reginanostraschools.com

# First admin account (used once by the seed command)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: request limits per 15 minutes per network
# RATE_LIMIT_MAX=2000
# AUTH_RATE_LIMIT_MAX=50
